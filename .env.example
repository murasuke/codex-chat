# Common
OPENAI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/help_chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat API
OPENAI_CHAT_MODEL=gpt-4.1-mini
PORT=8080

# Crawler
CRAWL_START_URL=https://docs.example.com/
CRAWL_ALLOWED_HOST=docs.example.com
CRAWL_MAX_PAGES=200
EMBEDDING_TPM_LIMIT=800000
EMBEDDING_MAX_BATCH_TOKENS=20000
EMBEDDING_MAX_RETRIES=6
EMBEDDING_RETRY_BASE_MS=300
